# Output files: everything under output/, subfolders included (backups
# there hold real candidate data). Only the placeholder is tracked.
output/**
!output/.gitkeep

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Your personal career document (ACTIVE by default to prevent accidental PII commits)
Master_Career_Document.md
!examples/Master_Career_Document.md

# Job descriptions with real company info
Job_Description-*.md
!examples/Job_Description-*.md

# Claude Code local settings
.claude/settings.local.json

# Per-candidate workspaces (candidates/<name>/ holds someone's MCD, job
# descriptions, and output) and source resumes dropped in for the builder.
/candidates/
/inputs/

# Old resumes in office formats, at the project root
/*.doc
/*.docx
/*.pages
/*.odt
/*.rtf
